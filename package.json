{
  "name": "xjaus",
  "homepage": "https://github.com/perjesus111-hub/xjaus",
  "repository": {
    "type": "git",
    "url": "https://github.com/perjesus111-hub/xjaus.git"
  },
  "main": "electron/main.cjs",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run copy-login",
    "copy-login": "mkdir -p dist && cp public/login.html dist/login.html",
    "test": "vitest run && node --test electron/verify-ipc-bounds.cjs electron/verify-security.cjs electron/verify-icons.cjs electron/verify-windows.cjs electron/verify-window-state.cjs electron/verify-window-drag.cjs electron/verify-theme.cjs scripts/verify-packaging.cjs scripts/verify-linux-hooks.cjs scripts/verify-appimage-update-preparation.cjs scripts/verify-release-gate.cjs",
    "electron": "electron . --class=io.github.xjaus.xjaus",
    "electron:build-backend": "cargo build --manifest-path src-tauri/Cargo.toml --bin xjaus_backend",
    "electron:run": "npm run build && npm run electron:build-backend && electron . --class=io.github.xjaus.xjaus",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:win": "electron-builder --win --x64 --publish never",
    "prebuild:win": "npm run build && npm run electron:build-backend:win",
    "electron:build-backend:win": "node scripts/build-windows.cjs",
    "electron:build-backend:linux": "node scripts/build-linux.cjs",
    "dist:linux": "node scripts/packaging.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "io.github.xjaus.xjaus",
    "productName": "XJAUS",
    "asar": true,
    "directories": {
      "output": "release/win",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "!electron/verify-*.cjs",
      "resources/icons/*.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/xjaus.ico",
      "executableName": "XJAUS",
      "extraResources": [
        {
          "from": "build/windows/bin",
          "to": "bin",
          "filter": [
            "xjaus_backend.exe",
            "*.dll"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "XJAUS-${version}-win-x64-setup.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "upgradeCode": "{0E62648A-3DF9-5B66-9869-BA2743BAE731}",
      "artifactName": "XJAUS-${version}-win-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "resources/icons",
      "maintainer": "XJAUS contributors",
      "vendor": "XJAUS contributors",
      "synopsis": "High-performance Xbox Cloud Gaming & Remote Play client for Linux",
      "artifactName": "XJAUS-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "src-tauri/target/release/xjaus_backend",
          "to": "bin/xjaus_backend"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE"
        }
      ],
      "syncDesktopName": true,
      "executableArgs": [
        "--class=io.github.xjaus.xjaus"
      ],
      "desktop": {
        "entry": {
          "Name": "XJAUS",
          "Comment": "High-performance Xbox Cloud Gaming & Remote Play client for Linux",
          "StartupWMClass": "io.github.xjaus.xjaus"
        }
      }
    },
    "deb": {
      "afterInstall": "resources/linux/package-hook-noop.sh",
      "afterRemove": "resources/linux/package-hook-noop.sh",
      "appArmorProfile": "resources/linux/apparmor-profile-disabled",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libxss1",
        "libc6 (>= 2.39)",
        "libgbm1",
        "libasound2"
      ]
    },
    "rpm": {
      "afterInstall": "resources/linux/package-hook-noop.sh",
      "afterRemove": "resources/linux/package-hook-noop.sh",
      "appArmorProfile": "resources/linux/apparmor-profile-disabled",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "libXScrnSaver",
        "libc.so.6(GLIBC_2.39)(64bit)",
        "mesa-libgbm",
        "alsa-lib"
      ]
    }
  },
  "description": "High-performance Xbox Cloud Gaming & Remote Play client for Linux",
  "license": "GPL-3.0-only",
  "author": {
    "name": "XJAUS contributors"
  },
  "desktopName": "io.github.xjaus.xjaus.desktop",
  "overrides": {
    "minimatch@^10.2.5": "11.0.8",
    "minimatch@^9.0.3": "11.0.8",
    "ajv@8.20.0": {
      "fast-uri": "3.1.9"
    }
  }
}
